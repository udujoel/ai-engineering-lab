# Copy to .env and fill in only what you need. .env is never committed.

# Where the Ollama server listens (default shown).
OLLAMA_HOST=http://localhost:11434

# Optional: force PyTorch onto one device (mps or cpu). Leave empty to auto pick.
PLAYGROUND_DEVICE=

# Optional: Hugging Face token, only needed for gated tokenizers such as Llama and Gemma.
HF_TOKEN=
